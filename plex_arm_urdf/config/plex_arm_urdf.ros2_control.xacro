<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="plex_arm_urdf_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <!-- By default, set up controllers for simulation. This won't work on real hardware -->
                <!--<plugin>mock_components/GenericSystem</plugin>-->
                <!-- To communicate with real hardware, we use the EtherCAT Driver plugin-->
                <plugin>ethercat_driver/EthercatDriver</plugin>
                <param name="master_id">0</param>
                <param name="control_frequency">1000.0</param>
            </hardware>
            <joint name="joint_1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_1']}</param>
                </state_interface>
                <!-- The ec_module tag tells the driver which physical slave this joint belongs to -->
                <!-- REPEATED FOR ALL JOINTS SINCE THEY ALL SHARE THE SAME PORT THROUGH MASTER ID -->
                <ec_module name="joint1_actuator">
                    <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
                    <param name="alias">0</param>
                    <param name="position">0</param> <!-- Physical position order in the EtherCAT cable daisy-chain -->
                    <param name="mode_of_operation">8</param>
                    <param name="slave_config">$(find ethercat_zeroerr)/config/zeroerr_config.yaml</param>
                </ec_module>
            </joint>
            <joint name="joint_2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_2']}</param>
                </state_interface>
                <!-- REPITITION -->
                <ec_module name="joint2_actuator">
                    <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
                    <param name="alias">0</param>
                    <param name="position">1</param>
                    <param name="mode_of_operation">8</param>
                    <param name="slave_config">$(find ethercat_zeroerr)/config/zeroerr_config.yaml</param>
                </ec_module>
            </joint>
            <joint name="joint_3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_3']}</param>
                </state_interface>
                <!-- REPITITION -->
                <ec_module name="joint3_actuator">
                    <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
                    <param name="alias">0</param>
                    <param name="position">2</param>
                    <param name="mode_of_operation">8</param>
                    <param name="slave_config">$(find ethercat_zeroerr)/config/zeroerr_config.yaml</param>
                </ec_module>
            </joint>
            <joint name="joint_4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_4']}</param>
                </state_interface>
                <!-- REPITITION -->
                <ec_module name="joint4_actuator">
                    <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
                    <param name="alias">0</param>
                    <param name="position">3</param>
                    <param name="mode_of_operation">8</param>
                    <param name="slave_config">$(find ethercat_zeroerr)/config/zeroerr_config.yaml</param>
                </ec_module>
            </joint>
            <joint name="joint_5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_5']}</param>
                </state_interface>
                <!-- REPITITION -->
                <ec_module name="joint5_actuator">
                    <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
                    <param name="alias">0</param>
                    <param name="position">4</param>
                    <param name="mode_of_operation">8</param>
                    <param name="slave_config">$(find ethercat_zeroerr)/config/zeroerr_config.yaml</param>
                </ec_module>
            </joint>
            <joint name="joint_6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['joint_6']}</param>
                </state_interface>
                <!-- REPITITION -->
                <ec_module name="joint6_actuator">
                    <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
                    <param name="alias">0</param>
                    <param name="position">5</param>
                    <param name="mode_of_operation">8</param>
                    <param name="slave_config">$(find ethercat_zeroerr)/config/zeroerr_config.yaml</param>
                </ec_module>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>

